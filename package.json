{
  "name": "release-note",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "concurrently --names \"R,T\" --prefix-colors \"blue.dim,magenta.dim\" \"tsdown --config ./tsdown.config.ts --watch\" \"tsc --noEmit --watch\"",
    "start": "run ./src/bin.ts"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "bin": {
    "release-note": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts",
        "./dist/index.d.cts"
      ]
    }
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.112",
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/azure": "^3.0.69",
    "@ai-sdk/baseten": "^1.0.51",
    "@ai-sdk/cerebras": "^2.0.54",
    "@ai-sdk/cohere": "^3.0.36",
    "@ai-sdk/deepinfra": "^2.0.52",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/fal": "^2.0.34",
    "@ai-sdk/fireworks": "^2.0.53",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/google-vertex": "^4.0.141",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/luma": "^2.0.33",
    "@ai-sdk/mistral": "^3.0.37",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/perplexity": "^3.0.33",
    "@ai-sdk/togetherai": "^2.0.53",
    "@ai-sdk/xai": "^3.0.93",
    "@commander-js/extra-typings": "^15.0.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "ai": "^6.0.195",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "concurrently": "^10.0.3",
    "cross-spawn": "^7.0.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown": "^1.0.3",
    "tsdown": "^0.22.1",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "zod": "^4.4.3"
  }
}
